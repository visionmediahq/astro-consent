---
import ConsentEmbed from '@visionmediahq/astro-consent/components/ConsentEmbed.astro'
import ConsentWidget from '@visionmediahq/astro-consent/components/ConsentWidget.astro'
import Base from '../layouts/Base.astro'
export const prerender = true
---

<Base title="Nästlad">
  <h1 class="text-2xl font-bold">Inbäddning i en widget</h1>
  <div class="mt-4">
    <ConsentWidget id="yttre" service="elfsight" script="https://elfsightcdn.com/platform.js" title="Instagram">
      <div class="elfsight-app-demo-yttre" data-elfsight-app-lazy></div>
      <ConsentEmbed
        id="inre"
        service="google-calendar"
        src="https://calendar.google.com/calendar/embed?src=demo%40group.calendar.google.com&ctz=Europe%2FStockholm"
        title="Kalender i flödet"
      />
    </ConsentWidget>
  </div>
</Base>
