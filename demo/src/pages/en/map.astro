---
import ConsentEmbed from '@visionmediahq/astro-consent/components/ConsentEmbed.astro'
import Base from '../../layouts/Base.astro'
export const prerender = true
---

<Base title="Map" lang="en">
  <h1 class="text-2xl font-bold">Find us</h1>
  <div class="mt-4">
    <ConsentEmbed
      id="en-map"
      lang="en"
      service="google-maps"
      src="https://www.google.com/maps/embed?pb=demo-en"
      title="Map to us"
    />
  </div>
</Base>
