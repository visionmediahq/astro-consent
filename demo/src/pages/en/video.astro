---
import ConsentEmbed from '@visionmediahq/astro-consent/components/ConsentEmbed.astro'
import Base from '../../layouts/Base.astro'
export const prerender = true
---

<Base title="Videos" lang="en">
  <h1 class="text-2xl font-bold">Our videos</h1>
  <div class="mt-4 flex flex-col gap-6">
    <ConsentEmbed id="video-watch" lang="en" service="youtube" src="https://www.youtube.com/watch?v=demoWatchEn&t=1m30s" title="How we train" />
    <div class="max-w-xs">
      <ConsentEmbed id="video-shorts" lang="en" service="youtube" src="https://www.youtube.com/shorts/demoShortEn" title="Throw of the week" />
    </div>
    <ConsentEmbed id="video-second" lang="en" service="youtube" src="https://youtu.be/demoSecndEn" title="The grading" />
  </div>
</Base>
