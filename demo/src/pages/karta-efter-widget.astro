---
import ConsentEmbed from '@visionmediahq/astro-consent/components/ConsentEmbed.astro'
import ConsentWidget from '@visionmediahq/astro-consent/components/ConsentWidget.astro'
import Base from '../layouts/Base.astro'
export const prerender = true
---

<Base title="Karta efter widget">
  <h1 class="text-2xl font-bold">Flöde, kalender och karta</h1>
  <div class="mt-4 flex flex-col gap-6">
    <ConsentWidget id="fore-kartan" service="elfsight" script="https://elfsightcdn.com/platform.js" title="Instagram">
      <div class="elfsight-app-demo-fore-kartan" data-elfsight-app-lazy></div>
    </ConsentWidget>
    <ConsentEmbed
      id="kalender-utan-filter"
      service="google-calendar"
      src="https://calendar.google.com/calendar/embed?src=demo%40group.calendar.google.com&ctz=Europe%2FStockholm"
      title="Vår kalender"
    />
    <div class="[&_iframe]:grayscale">
      <ConsentEmbed id="gra-karta" service="google-maps" src="https://www.google.com/maps/embed?pb=demo-gra" title="Grå karta" />
    </div>
  </div>
</Base>
