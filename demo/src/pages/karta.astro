---
import ConsentEmbed from '@visionmediahq/astro-consent/components/ConsentEmbed.astro'
import Base from '../layouts/Base.astro'
export const prerender = true
---

<Base title="Karta">
  <h1 class="text-2xl font-bold">Hitta hit</h1>
  <div class="mt-4 flex flex-col gap-6">
    <ConsentEmbed
      id="with-href"
      service="google-maps"
      src="https://www.google.com/maps/embed?pb=demo"
      href="https://www.google.com/maps/search/?api=1&query=demo"
      title="Karta till oss"
    >
      <Fragment slot="placeholder"><p>Demogatan 1, 123 45 Demostad</p></Fragment>
    </ConsentEmbed>
    <ConsentEmbed
      id="no-href"
      service="google-maps"
      src="https://maps.google.com/maps?q=demo&output=embed"
      title="Karta två"
    />
  </div>
</Base>
