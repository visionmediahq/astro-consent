---
// Static markup, hidden until the browser runtime (client.ts) decides to show it.
// Rendered once per page, next to the footer. Themed entirely by the site's DaisyUI theme.
import '../styles/contrast.css'
import config from 'virtual:astro-consent/config'
import { SERVICES, serviceText, type Category, type ServiceSlug } from '../services'
import { policyUrlFor } from '../policy-url'
import { TEXTS, resolveLang } from '../text'

interface Props {
  /** Banner language ("sv" or "en"); defaults to the page's locale, else Swedish. */
  lang?: string
}

const lang = resolveLang(Astro.props.lang, Astro.currentLocale)
const t = TEXTS[lang]
const policyUrl = policyUrlFor(config, lang)
const mode = config.services.length > 0 ? 'consent' : 'notice'
const servicesIn = (category: Category): ServiceSlug[] =>
  config.services.filter((slug) => SERVICES[slug].category === category)
---

<section
  data-consent-banner
  data-mode={mode}
  data-view="main"
  hidden
  role="region"
  aria-label={t.region}
  lang={lang === 'sv' ? undefined : lang}
  class:list={[
    'card fixed inset-x-4 bottom-4 z-[99] mx-auto max-h-[calc(100dvh-2rem)] max-w-[42rem] overflow-y-auto border border-base-300 bg-base-100 text-base-content shadow-xl',
    // #131: on a phone the notice is a bar flush with the bottom edge, not a card covering a quarter of the first screen.
    mode === 'notice' && 'max-sm:inset-x-0 max-sm:bottom-0 max-sm:rounded-none max-sm:border-x-0 max-sm:border-b-0 max-sm:shadow-none',
  ]}
>
  <div
    class:list={[
      'card-body gap-3 p-4',
      mode === 'notice' && 'max-sm:gap-2 max-sm:px-4 max-sm:pt-3 max-sm:pb-[calc(0.75rem+env(safe-area-inset-bottom))]',
    ]}
  >
    {
      mode === 'notice' ? (
        <>
          <h2 class="card-title text-base">{t.notice.title}</h2>
          <p class="text-base sm:text-sm">
            {t.notice.body}
            {policyUrl && (
              <>
                {' '}
                <a class="link text-base-content" href={policyUrl}>{t.notice.more}</a>
              </>
            )}
          </p>
          <div class="card-actions justify-end">
            <button type="button" class="btn btn-primary max-sm:w-full max-sm:text-base sm:btn-sm" data-consent-action="notice_ok">
              {t.notice.ok}
            </button>
          </div>
        </>
      ) : (
        <>
          <div data-consent-main class="flex flex-col gap-3">
            <h2 class="card-title text-base">{t.consent.title}</h2>
            <p class="text-base sm:text-sm">
              {t.consent.body}
              {policyUrl && (
                <>
                  {' '}
                  <a class="link text-base-content" href={policyUrl}>{t.consent.more}</a>
                </>
              )}
            </p>
            <div class="card-actions justify-end gap-2 max-sm:grid max-sm:grid-cols-2">
              <button type="button" class="btn btn-ghost max-sm:order-last max-sm:col-span-2 max-sm:w-full max-sm:text-base sm:btn-sm" data-consent-action="settings">
                {t.consent.settings}
              </button>
              {/* Same classes as "Acceptera alla": declining must be as prominent as accepting. */}
              <button type="button" class="btn btn-primary max-sm:w-full max-sm:text-base sm:btn-sm" data-consent-action="none">
                {t.consent.decline}
              </button>
              <button type="button" class="btn btn-primary max-sm:w-full max-sm:text-base sm:btn-sm" data-consent-action="all">
                {t.consent.acceptAll}
              </button>
            </div>
          </div>

          <form data-consent-settings hidden class="flex flex-col gap-3">
            <h2 class="card-title text-base">{t.consent.settings}</h2>
            {config.categories.map((category) => (
              <div data-consent-category={category} class="flex flex-col gap-1">
                {/* A plain flex row: DaisyUI 5's .label does not wrap and dims the text. */}
                <label class="flex cursor-pointer items-start justify-between gap-4">
                  <span>
                    <span class="text-base font-medium sm:text-sm">{t.categories[category].label}</span>
                    <span class="block whitespace-normal text-base text-base-content/80 sm:text-xs">
                      {t.categories[category].description}
                    </span>
                  </span>
                  {/* Toggles get an explicit boundary (WCAG 1.4.11): DaisyUI's is base-content at 50 %
                      unchecked and the primary colour once checked, and a pale primary is under 3:1 on
                      base-100. Checked, the ring is full base-content, as DaisyUI's uncoloured toggle has it. */}
                  {category === 'necessary' ? (
                    <span class="flex shrink-0 items-center gap-2">
                      <span class="badge badge-neutral badge-sm">{t.consent.alwaysOn}</span>
                      <input type="checkbox" class="toggle toggle-sm" name="necessary" checked disabled />
                    </span>
                  ) : (
                    <input
                      type="checkbox"
                      class="toggle toggle-primary toggle-sm shrink-0 border-base-content/60 checked:border-base-content"
                      name={category}
                    />
                  )}
                </label>
                {servicesIn(category).map((slug) => (
                  <label
                    data-consent-service={slug}
                    hidden
                    class="flex cursor-pointer items-center justify-between gap-4 pl-4"
                  >
                    <span class="text-base sm:text-xs">{t.consent.serviceRow.replace('{name}', serviceText(slug, lang).name)}</span>
                    <input
                      type="checkbox"
                      class="toggle toggle-xs shrink-0 border-base-content/60 checked:border-base-content"
                      name={`service:${slug}`}
                    />
                  </label>
                ))}
              </div>
            ))}
            <div class="card-actions justify-end gap-2">
              <button type="button" class="btn btn-ghost max-sm:w-full max-sm:text-base sm:btn-sm" data-consent-action="back">
                {t.consent.back}
              </button>
              <button type="submit" class="btn btn-primary max-sm:w-full max-sm:text-base sm:btn-sm" data-consent-action="custom">
                {t.consent.save}
              </button>
            </div>
          </form>
        </>
      )
    }
  </div>
</section>
