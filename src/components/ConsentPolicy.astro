---
// The site's cookie and privacy text (#89), rendered from privacy.json and the service registry so it
// always names what this site actually loads. Put it on the site's own page (/cookies, or inside an
// existing /integritetspolicy). Headings are h2: the host page owns the h1. The settings button
// reopens the banner like PrivacyLinks does (client.ts listens for any [data-consent-open]).
//
// It is a section, not a whole privacy policy: it covers cookies, Umami and embedded services, not
// a site's contact form or server logs. It says the site measures visits with Umami, as the banner
// does on every site; use it only on sites that do.
//
// What it covers, and why (GDPR art. 13, LEK 9 kap. 28 §): who is responsible and how to reach them
// (privacy.json `controller`), who processes for them (`processor`), what is stored or sent and on
// what legal basis, how long, recipients (the vendors) and transfers outside the EU, the visitor's
// rights and the right to complain to IMY, and how to withdraw consent.
import config from 'virtual:astro-consent/config'
import policy from 'virtual:astro-consent/policy'
import { fill, monthsOf, splitAt } from '../policy'
import { SERVICES } from '../services'
import { MAX_AGE_MS, STORAGE_KEY } from '../store'
import sv from '../text/sv.json'

interface Props {
  class?: string
}

const p = sv.policy
const { controller, processor } = policy
const name = controller ? (controller.org_number ? fill(p.controllerName, { name: controller.name, org_number: controller.org_number }) : controller.name) : ''
const h2 = 'text-lg font-semibold'

// GDPR art. 13.1 a asks for the controller's identity and contact: say so where the technician looks.
// Only when the page is built (or in dev): an on-demand page would log it on every request.
if (!controller && (Astro.isPrerendered || import.meta.env.DEV)) {
  console.warn(`[astro-consent] ${Astro.url.pathname}: ConsentPolicy has no controller in privacy.json; add "controller": { "name", "email" } so the page says who is responsible`)
}
const [controllerBefore, controllerAfter] = splitAt(p.controller, 'email', { name })
const [objectBefore, objectAfter] = splitAt(p.statsObject, 'email', {})
const [rightsBefore, rightsAfter] = splitAt(p.rightsContact, 'email', {})
---

<section data-consent-policy class:list={['flex flex-col gap-3', Astro.props.class]}>
  {
    controller && (
      <div data-consent-policy-controller class="flex flex-col gap-3">
        <h2 class={h2}>{p.controllerTitle}</h2>
        <p>
          {controllerBefore}
          <a class="link" href={`mailto:${controller.email}`}>{controller.email}</a>
          {controllerAfter}
          {controller.address && <> {fill(p.address, { address: controller.address })}</>}
        </p>
        {processor && <p>{fill(p.processor, { processor })}</p>}
      </div>
    )
  }

  <h2 class={h2}>{p.storedTitle}</h2>
  <p>
    {fill(p.stored, { key: STORAGE_KEY, months: String(monthsOf(MAX_AGE_MS)) })}
    {config.logEndpoint && <> {p.logged}</>}
  </p>

  <div data-consent-policy-stats class="flex flex-col gap-3">
    <h2 class={h2}>{p.statsTitle}</h2>
    <p>{p.stats}</p>
    <p>
      {
        controller ? (
          <>
            {objectBefore}
            <a class="link" href={`mailto:${controller.email}`}>{controller.email}</a>
            {objectAfter}
          </>
        ) : (
          p.statsObjectNoEmail
        )
      }
    </p>
  </div>

  {
    config.services.length > 0 && (
      <>
        <h2 class={h2}>{p.servicesTitle}</h2>
        <p>{p.servicesIntro}</p>
        <p>{p.transfers}</p>
        <ul class="flex list-disc flex-col gap-2 pl-5">
          {config.services.map((slug) => {
            const s = SERVICES[slug]
            return (
              <li data-consent-policy-service={slug}>
                <strong>{s.name}</strong> ({s.vendor}). {s.description_sv} {fill(p.category, { label: sv.categories[s.category].label })}{' '}
                <a class="link" href={s.privacy_url} rel="noopener noreferrer">
                  {fill(p.vendorPolicy, { vendor: s.vendor })}
                </a>
              </li>
            )
          })}
        </ul>
      </>
    )
  }

  <div data-consent-policy-rights class="flex flex-col gap-3">
    <h2 class={h2}>{p.rightsTitle}</h2>
    <p>{p.rights}</p>
    <p>
      {
        controller ? (
          <>
            {rightsBefore}
            <a class="link" href={`mailto:${controller.email}`}>{controller.email}</a>
            {rightsAfter}
          </>
        ) : (
          p.rightsContactNoEmail
        )
      }
    </p>
    <p>
      {p.complaint} <a class="link" href="https://www.imy.se/" rel="noopener noreferrer">{p.complaintLink}</a>
    </p>
  </div>

  <h2 class={h2}>{p.changeTitle}</h2>
  <p>{p.change}</p>
  <p>
    <button type="button" class="btn btn-sm" data-consent-open>{sv.links.settings}</button>
  </p>
</section>
