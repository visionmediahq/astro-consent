---
// Click-to-load embed. The iframe sits inert in a <template> until the visitor clicks "Visa" or
// has granted the service. Never put a <script> in this component's slots: Astro bundles and runs
// it regardless of the template. Anything loaded by script goes through onConsent() instead.
import '../styles/contrast.css'
import config from 'virtual:astro-consent/config'
import { deEmbed } from '../embed-url'
import { scanError } from '../scan'
import { SERVICES, type ServiceSlug } from '../services'
import sv from '../text/sv.json'

interface Props {
  service: ServiceSlug
  /** The embed URL, exactly as the provider gives it. */
  src: string
  /** Link to open the content at the provider; defaults to a de-embedded `src`. */
  href?: string
  title: string
  /** CSS aspect-ratio of the box, e.g. "16 / 9". */
  aspect?: string
  id?: string
}

const { service, src, href, title, aspect = '16 / 9', id } = Astro.props

// Fallback for a non-literal `service`; literal ones are caught by the build-time scan.
if (!config.services.includes(service)) {
  throw new Error(scanError(Astro.url.pathname, service, config.services))
}

const { name } = SERVICES[service]
const openHref = href ?? deEmbed(src)
const fill = (text: string, vars: Record<string, string>): string =>
  text.replace(/\{(\w+)\}/g, (match, key: string) => vars[key] ?? match)
---

<div
  id={id}
  data-consent-embed={service}
  class="relative flex flex-col rounded-box bg-base-200 text-base-content data-active:overflow-hidden"
  style={`aspect-ratio: ${aspect}`}
>
  <template data-payload>
    <iframe
      src={src}
      title={title}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
      class="absolute inset-0 h-full w-full rounded-box border-0"></iframe>
  </template>
  {/* In normal flow, not absolute: on a narrow screen the box grows instead of clipping. */}
  <div data-placeholder class="flex flex-1 flex-col justify-between gap-3 p-4">
    <div class="text-sm">
      <slot name="placeholder">
        <p>{fill(sv.embed.info, { title, name })}</p>
      </slot>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" class="btn btn-primary btn-sm" data-load>{fill(sv.embed.show, { title })}</button>
      <label class="flex cursor-pointer items-center gap-2 text-xs">
        <input type="checkbox" class="checkbox checkbox-sm" data-remember />
        {fill(sv.embed.remember, { name })}
      </label>
      <a href={openHref} target="_blank" rel="noopener noreferrer" class="link text-xs" data-open>
        {fill(sv.embed.open, { name })}
      </a>
    </div>
  </div>
</div>
