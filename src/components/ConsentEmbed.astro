---
// Click-to-load embed. The iframe sits inert in a <template> until the visitor clicks "Visa" or
// has granted the service. Never put a <script> in this component's slots: Astro bundles and runs
// it regardless of the template. Anything loaded by script goes through onConsent() instead.
import '../styles/contrast.css'
import config from 'virtual:astro-consent/config'
import { deEmbed } from '../embed-url'
import { scanError } from '../scan'
import { type ServiceSlug, srcMatchesService } from '../services'
import sv from '../text/sv.json'
import EmbedPlaceholder from './EmbedPlaceholder.astro'

interface Props {
  service: ServiceSlug
  /** The embed URL, exactly as the provider gives it. */
  src: string
  /** Link to open the content at the provider; defaults to a de-embedded `src`. */
  href?: string
  title: string
  /** CSS aspect-ratio of the box, e.g. "16 / 9". */
  aspect?: string
  id?: string
}

const { service, src, href, title, aspect = '16 / 9', id } = Astro.props

// Fallback for a non-literal `service`; literal ones are caught by the build-time scan.
if (!config.services.includes(service)) {
  throw new Error(scanError(Astro.url.pathname, service, config.services))
}

// #107: a src that is not the service's (a CMS field holding another site's URL) would load that
// site under the service's name after consent. Render a message instead, and say so in the log.
const belongs = srcMatchesService(src, service)
if (!belongs) {
  let host = '(no host)'
  try {
    host = new URL(src.startsWith('//') ? `https:${src}` : src).host || host
  } catch {}
  console.warn(`[astro-consent] ${Astro.url.pathname}: ConsentEmbed service="${service}" has a src on ${host}, which is not ${service}'s; it renders a message instead of the embed`)
}

// No per-instance id exists (`id` is optional), so the info element gets a random suffix.
const infoId = `${id ?? 'consent-embed-' + crypto.randomUUID().slice(0, 8)}-info`
const openHref = href ?? deEmbed(src)
---

{!belongs ? (
  <div id={id} class="flex items-center rounded-box bg-base-200 p-4 text-base text-base-content sm:text-sm">
    <p>{sv.embed.unavailable.replace('{title}', title)}</p>
  </div>
) : (
<div
  id={id}
  data-consent-embed={service}
  class="relative flex flex-col rounded-box bg-base-200 text-base-content data-active:overflow-hidden"
  style={aspect === 'auto' ? undefined : `aspect-ratio: ${aspect}`}
>
  <template data-payload>
    <iframe
      src={src}
      title={title}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
      class="absolute inset-0 h-full w-full rounded-box border-0"></iframe>
  </template>
  {
    Astro.slots.has('placeholder') ? (
      <EmbedPlaceholder service={service} title={title} infoId={infoId} openHref={openHref}>
        <slot name="placeholder" />
      </EmbedPlaceholder>
    ) : (
      <EmbedPlaceholder service={service} title={title} infoId={infoId} openHref={openHref} />
    )
  }
</div>
)}
